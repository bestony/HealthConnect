{
	email {$ACME_EMAIL}
}

# Local process check. This site does not serve the public name.
http://127.0.0.1 {
	respond /healthz 200
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	reverse_proxy healthd:8080 {
		# Stream request and response bodies. Do not buffer an upload.
		flush_interval -1
	}
}
