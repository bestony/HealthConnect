# Public DNS name for this host. Point the name at this host before you start.
DOMAIN=health.example.com

# Let's Encrypt account email. Caddy uses this address for certificate notices.
ACME_EMAIL=ops@example.com

# healthd log level: debug, info, warn, or error.
LOG_LEVEL=info

# Set false to disable the /mcp endpoint.
MCP_ENABLED=true

# Maximum HTTP body size, in bytes. The default is 8 GiB.
MAX_UPLOAD_BYTES=8589934592

# Maximum uncompressed import size, in bytes. The default is 16 GiB.
MAX_UNCOMPRESSED_BYTES=17179869184
